# ===================================
# NFT Claiming Platform - 환경 변수
# ===================================

# ===================================
# RPC 설정 (하나만 선택)
# ===================================

# Option 1: Helius (추천) ⭐
# https://helius.xyz 에서 가입 후 API Key 받기
# 무료 티어: 100,000 requests/월
VITE_HELIUS_API_KEY=

# Option 2: QuickNode
# https://quicknode.com 에서 가입 (7일 무료 체험)
VITE_QUICKNODE_ENDPOINT=

# Option 3: Alchemy
# https://alchemy.com 에서 가입
# 무료 티어: 300M Compute Units/월
VITE_ALCHEMY_API_KEY=

# ===================================
# 사용 예시
# ===================================

# Helius 예시:
# VITE_HELIUS_API_KEY=abc123-def456-ghi789

# QuickNode 예시:
# VITE_QUICKNODE_ENDPOINT=https://solana-mainnet.quiknode.pro/abc123/

# Alchemy 예시:
# VITE_ALCHEMY_API_KEY=abc123def456ghi789

# ===================================
# 주의사항
# ===================================
# 1. 위의 RPC 옵션 중 하나만 설정하세요
# 2. API 키는 절대 GitHub에 커밋하지 마세요
# 3. .env 파일은 .gitignore에 포함되어 있습니다
# 4. 설정 후 개발 서버를 재시작하세요: npm run dev
