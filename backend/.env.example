# 환경 변수 설정
# 이 파일은 절대 GitHub에 업로드하지 마세요!

# Solana 네트워크
NETWORK=mainnet-beta

# Treasury 지갑 개인키 (Phantom 지갑의 Private Key를 여기에 입력)
# Phantom에서 내보내기: 설정 > 보안 및 개인정보 > 개인키 내보내기
TREASURY_PRIVATE_KEY=your_private_key_here

# 토큰 민트 주소 (MONGMONG)
TOKEN_MINT_ADDRESS=6amToBpuYrDhDNg75ZnjnpESLBCtgd3KqzsEcMrizAfX

# 서버 포트
PORT=5000

# CORS 허용 도메인
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RPC 엔드포인트 (선택사항, 비워두면 기본 RPC 사용)
# 더 빠른 RPC를 원하면 https://www.quicknode.com/ 또는 https://www.helius.dev/ 사용
RPC_ENDPOINT=
